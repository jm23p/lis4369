


# 1. import necessary packages
import sys
import os
import pandas as pd
print(sys.version) # print python version
print (os.environ['CONDA_DEFAULT_ENV']) # print conda environment


# 2. get/read patient data
# Note: data is de-identified and anonymized
df_patients = pd.read_csv("patients.csv")
df_patients # display first/last five records (Note: zero-based index)


# 3. Check type
type(df_patients)


# 4. display number of rows and cols (1,000,000 rows and 13 cols)
df_patients.shape


# 5. print DataFrame information
# Note: prints columns, column labels, column data types, memory usage, range index, and number of cells in each column (non-null values)
df_patients.info()


# 6. Check missing values
# isna(): detects missing values (True = missing, False = not missing)
df_patients.isna()


# 7. display sum of all missing values for each column
# Note: Concise display all cols, and any missing values
df_patients.isna().sum()


# 8. Note: if missing values, can drop missing values
# following code creates new DF
df_patients = df_patients.dropna()
df_patients


# 9. display first 5 records
df_patients.head()


# 10. display last 5 records
df_patients.tail()


# 11. display first 10 records - can do same with tail()
df_patients.head(10)


# 12. rename cols
# Note: last five cols (times in minutes)
df_patients.rename(columns={'Registration': 'Registration_mins'})

# Note: rename() vs. df.columns.str.replace()
# rename(): explicitly change one or more column names from old name to new name
# df.columns.str.replace(): modify content of column names by replacing characters or patterns within names


# 13. Note: rename not permanent, unless using "inplace" option
df_patients.head() # display first 5 records


# 14. Make DF col names permanent
# Note: Does NOT affect data source (i.e. here, .csv file), only df
df_patients.rename(columns={'Registration': 'Registration_mins'},inplace=True)
df_patients.head() # display first 5 records


# 15. modify more than one col (using dictionary), AND make permanent DF changes
column_mapping = {'Postcode': 'Zip', 'Nursing':'Nursing_mins','Laboratory': 'Laboratory_mins','Consultation':'Consultation_mins','Pharmacy': 'Pharmacy_mins'}
df_patients.rename(columns=column_mapping,inplace=True)
df_patients.head()


# 16. save changes to .csv file
df_patients.to_csv('patients_clean.csv')


# 17. get/read "cleaned" patient data
pd.read_csv("patients_clean.csv")


# 18. solution: set index=False
# Note: DataFrame's index not written as column in .csv file
df_patients.to_csv('patients_clean.csv', index=False)

# get/read "cleaned" patient data
df_patients = pd.read_csv("patients_clean.csv")
df_patients


# 19. assign variable for plotting
patient_insurance = df_patients['Has_Insurance'].value_counts()


# 20. plot patients with/without insurance
import matplotlib.pyplot as plt

patient_insurance.plot(kind='bar')
plt.show()



